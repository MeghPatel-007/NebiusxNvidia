# ==============================================================================
# REPOVERSE (NIMBUS) AUTHENTICATION & ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in real values. Never commit secrets to git.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Neon PostgreSQL connection string (serverless pooled URL recommended)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. BETTER AUTH CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Cryptographically secure random secret (min 32 characters in production)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-plus-character-cryptographically-secure-secret-here"

# Canonical public application URL
# In development: http://localhost:3000
# In production: https://yourdomain.com
BETTER_AUTH_URL="http://localhost:3000"

# Optional comma-separated allowlist of additional trusted origins
# TRUSTED_ORIGINS="https://preview.yourdomain.com,https://staging.yourdomain.com"

# ------------------------------------------------------------------------------
# 3. SOCIAL OAUTH PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# GitHub OAuth App credentials (for user sign-in only)
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth credentials (for user sign-in only)
# Register at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
# In development: leave empty to use the built-in in-memory email adapter
# In production: provide your verified Resend API key and verified sender address
RESEND_API_KEY=""
EMAIL_FROM="resend"

# Optional email adapter override: "memory" or "resend"
# EMAIL_ADAPTER="memory"

# ------------------------------------------------------------------------------
# 5. GITHUB APP REPOSITORY INTEGRATION (Existing Feature - NOT OAuth Sign-In)
# ------------------------------------------------------------------------------
# Distinct from GitHub OAuth login. Used by the autonomous agent to sync repositories.
GITHUB_APP_SLUG="repopilot-agent"
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
